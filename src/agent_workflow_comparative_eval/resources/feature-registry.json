        "candidate_timeout_seconds": 10,
        "normal_usage": true,
        "sample_rate": 0.1,
        "static": true
      },
      "control": {
        "kind": "agent-workflow-deterministic-routing"
      },
      "feature_id": "routing-advice/v1",
      "metrics": [
        "accuracy",
        "confusion_matrix",
        "control_only_correct",
        "candidate_only_correct",
        "duration",
        "tokens",
        "cost",
        "timeouts",
        "fallbacks",
        "calibration",
        "downstream_outcomes"
      ],
      "normalization": {
        "dimensions": [
          "task_class",
          "interactive",
          "risk",
          "final_route"
        ]
      },
      "oracle": {
        "normal_usage": "optional-adjudication-plus-downstream-proxies",
