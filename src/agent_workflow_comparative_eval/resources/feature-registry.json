      },
      "schema": "agent-workflow-comparative-eval/eval-feature/v1"
    },
    {
      "candidate": {
        "kind": "semantic-behavior-evaluation"
      },
      "capture": {
        "candidate_timeout_seconds": 10,
        "normal_usage": true,
        "sample_rate": 0.1,
        "static": true
      },
      "control": {
        "kind": "agent-workflow-deterministic-skill-regex"
      },
      "feature_id": "skill-behavior-eval/v1",
      "metrics": [
        "accuracy",
        "precision",
        "recall",
        "f1",
        "control_only_correct",
        "candidate_only_correct",
        "duration",
        "tokens",
        "cost",
        "timeouts",
        "fallbacks",
        "brier",
        "stability"
      ],
      "normalization": {
        "dimensions": [
          "behavior_satisfied"
        ]
      },
      "oracle": {
        "normal_usage": "optional-review-adjudication",
        "static": "adjudicated-label"
      },
      "schema": "agent-workflow-comparative-eval/eval-feature/v1"
    }
  ]
