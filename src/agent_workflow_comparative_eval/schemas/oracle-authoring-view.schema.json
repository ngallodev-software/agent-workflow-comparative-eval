{
  "$id": "agent-workflow-comparative-eval/oracle-authoring-view/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent-workflow-comparative-eval/oracle-authoring-view/v1"},
    "study_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "decision_seams": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "oracle_policy": {"type": "object"},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "construction_tags_included": {"const": false},
        "control_outputs_included": {"const": false},
        "candidate_outputs_included": {"const": false}
      },
      "required": ["construction_tags_included", "control_outputs_included", "candidate_outputs_included"]
    }
  },
  "required": ["schema", "study_id", "dataset_version", "decision_seams", "oracle_policy", "cases", "blinding"]
}
