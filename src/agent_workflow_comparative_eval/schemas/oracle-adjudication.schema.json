{
  "$id": "agent-workflow-comparative-eval/oracle-adjudication/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent-workflow-comparative-eval/oracle-adjudication/v1"},
    "study_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "adjudicator_id": {"type": "string", "minLength": 1},
    "blinded": {"const": true},
    "completed_at": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "routing.task_class": {"enum": ["implementation", "diagnosis", "review", "documentation", "other"]},
              "routing.interaction_required": {"type": "boolean"},
              "routing.semantic_risk": {"type": "integer", "minimum": 0, "maximum": 2}
            },
            "minProperties": 1
          },
          "rationales": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        },
        "required": ["case_id", "labels", "rationales"]
      }
    }
  },
  "required": ["schema", "study_id", "dataset_version", "protocol_version", "adjudicator_id", "blinded", "completed_at", "records"]
}
