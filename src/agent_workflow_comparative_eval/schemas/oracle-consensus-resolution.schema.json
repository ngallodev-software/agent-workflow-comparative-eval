{
  "$id": "agent-workflow-comparative-eval/oracle-consensus-resolution/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent-workflow-comparative-eval/oracle-consensus-resolution/v1"},
    "study_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "minLength": 1},
    "resolved_by": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "blinded_to_treatment_outputs": {"const": true},
    "completed_at": {"type": "string", "minLength": 1},
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "decision_id": {"enum": ["routing.task_class", "routing.interaction_required", "routing.semantic_risk"]},
          "label": {
            "oneOf": [
              {"enum": ["implementation", "diagnosis", "review", "documentation", "other"]},
              {"type": "boolean"},
              {"type": "integer", "minimum": 0, "maximum": 2}
            ]
          },
          "rationale": {"type": "string", "minLength": 1}
        },
        "required": ["case_id", "decision_id", "label", "rationale"]
      }
    }
  },
  "required": ["schema", "study_id", "dataset_version", "protocol_version", "resolved_by", "blinded_to_treatment_outputs", "completed_at", "resolutions"]
}
